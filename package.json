{
  "name": "web-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --remote",
    "types": "wrangler types",
    "type-check": "tsc --noEmit",
    "check": "npm run types && npm run type-check && wrangler deploy --dry-run --outdir dist",
    "deploy": "npm run check && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
}
